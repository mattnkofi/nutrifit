# Copy this file to `.env` and fill in your own values.
# Never commit real secrets.

# Supabase (Auth). The anon key is public in the browser; never use the service role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini (AI coach, meal/workout generation)
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_MODEL=gemini-2.5-flash

# YouTube Data API (optional; falls back to built-in videos)
VITE_YOUTUBE_API_KEY=your-youtube-api-key

# ---------------------------------------------------------------------------
# Email provider (Supabase Auth -> custom SMTP)
# Used by scripts/apply-auth-emails.mjs. Never prefix these with VITE_ —
# non-VITE keys stay out of the browser bundle.
# Brevo: host smtp-relay.brevo.com, port 587, user = SMTP login,
# password = SMTP key (not the API key), sender = a verified sender address.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=NutriFit

# Optional: Supabase Management API personal token for the scripts
# (sbp_..., not the anon key). https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=

# Optional: point the scripts at a different project.
# SUPABASE_PROJECT_REF=nulbklefdrfoknlqaeqq
